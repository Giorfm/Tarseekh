# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server/Admin Secret (Server and scripts only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chat Limits
CHAT_DAILY_LIMIT=30

# Mushaf page images (optional). Defaults to the public Supabase bucket
# {NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public/mushaf/kfgqpc-1441 (see scripts/mushaf-ocr/README.md).
# Without any image source the per-page view uses the text layout.
# NEXT_PUBLIC_MUSHAF_IMAGE_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/mushaf/kfgqpc-1441
